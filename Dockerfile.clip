# Linux amd64 matches the initial Azure CPU worker and MediaPipe wheel support.
FROM python:3.11-slim-bookworm AS dependencies
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHON_DOTENV_DISABLED=1 PIP_NO_CACHE_DIR=1 \
    HF_HOME=/opt/models/huggingface YOLO_MODEL_PATH=/opt/models/yolov8n.pt \
    OMP_NUM_THREADS=2 MKL_NUM_THREADS=2
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg curl libgl1 libglib2.0-0 libgomp1 fonts-liberation fonts-noto-core \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-clip-core.txt requirements-clip-foundry.txt requirements-clip-storage.txt requirements-clip-media.txt ./
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch==2.11.0 torchvision==0.26.0
RUN pip install -r requirements-clip-media.txt && pip check

FROM dependencies AS runtime
# Match the main image's supported JS runtime; EJS ships with yt-dlp[default].
COPY --from=denoland/deno:bin /deno /usr/local/bin/deno
COPY *.py ./
COPY clip_pipeline ./clip_pipeline
COPY configs ./configs
COPY fonts ./fonts
RUN mkdir -p /opt/models /data && cd /opt/models && \
    python -c "from ultralytics import YOLO; YOLO('yolov8n.pt')"
ENTRYPOINT ["python", "-m", "clip_pipeline"]
CMD ["--help"]

# Actual ASR and detector weights, generated speech, and no network at test time.
FROM runtime AS media-test
RUN apt-get update && apt-get install -y --no-install-recommends espeak-ng \
    && rm -rf /var/lib/apt/lists/*
RUN python -c "from faster_whisper import WhisperModel; WhisperModel('tiny', device='cpu', compute_type='int8')"
COPY tests/media_smoke.py tests/story_media_smoke.py tests/audit_media_smoke.py /app/tests/
ENTRYPOINT ["python", "/app/tests/media_smoke.py"]
